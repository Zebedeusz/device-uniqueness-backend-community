# Identity Backend V2 — local dev environment variables
# Copy this file to `.env` and adjust values as needed.
# Docker Compose auto-loads `.env` from this directory.

# --- identity-api ---

# Listen address (default: 0.0.0.0:8080 when set via compose)
BIND_ADDR=0.0.0.0:8080

# Postgres connection string (override for external DB)
DATABASE_URL=postgres://identity:identity@localhost:5432/identity

# Host port for the Compose identity Postgres (the live-test lane overrides it).
IDENTITY_POSTGRES_PORT=5432

# People Chain RPC URL (Paseo Next v2 is the default)
PEOPLE_RPC_URL=wss://paseo-people-next-system-rpc.polkadot.io

# JWT signing key — 32-byte Ed25519 seed as 0x-prefixed 64-char hex
JWT_ED25519_SECRET=0x0101010101010101010101010101010101010101010101010101010101010101

# Attester public key — sr25519 pubkey as 0x-prefixed 64-char hex
ATTESTER_PUBLIC_KEY=0xd43593c715fdd31c61141abd04a99fd6822c8558854ccde39a5684e7a56da27d

# Attestation gating
AUTH_ENABLED=false
ENFORCE_AUTH=false

# Registration queue (spec: balance-priority FIFO). false = M0 direct-to-writer
# flow and wire. true = claims wait as QUEUED rows with a priority group from
# the subject's on-chain balance, drained by the separate registration-queue
# service. Intake only queues while that service's lease is live — a down
# queue service automatically falls back to the direct path.
QUEUE_ENABLED=false

# Accept the optional DotNS registration block.
DOTNS_GATEWAY_ENABLED=true

# Maximum age of dotns.signedAt in seconds (>=0; 0 requires a current timestamp).
DOTNS_INTAKE_FRESHNESS_MAX_AGE_SECS=600

# Maximum tolerated future clock skew for dotns.signedAt in seconds (>=0).
DOTNS_MAX_FUTURE_SKEW_SECS=600

# iOS App Attest (required non-empty when AUTH_ENABLED=true; ignored otherwise).
# App IDs are TEAMID.bundleId; rpIdHash in attestations/assertions must match one.
# APPLE_APP_ATTEST_APP_IDS=TEAMID.io.pcf.polkadotapp,TEAMID.io.pcf.polkadotapp.nightly
# Bundle ids accepted in the Auth-iOS-Package header.
# IOS_PACKAGE_NAMES=io.pcf.polkadotapp,io.pcf.polkadotapp.nightly
# Android attestation (required when AUTH_ENABLED=true; ignored otherwise).
# Package names accepted in key-attestation (and later Play Integrity) verdicts.
# ANDROID_PACKAGE_NAMES=io.pcf.polkadotapp,io.pcf.polkadotapp.nightly
# SHA-256 signing-certificate fingerprints (colon-separated or bare hex; the
# per-environment values come from the Play Console signing-key fingerprints).
# Play Store channel -> appFromOfficialStore=true; website/vanilla -> false.
# ANDROID_SIGNING_DIGEST_PLAYSTORE=7B:47:1D:1B:BC:16:F8:FD:81:1F:09:AC:E1:C0:54:1B:A4:62:E6:26:7A:2B:7B:6A:BB:EC:3F:6D:FB:EA:30:61
# ANDROID_SIGNING_DIGEST_WEBSITE=5A:A3:A6:D7:C8:F2:DE:24:2C:B0:E9:77:62:E2:E5:52:5B:0A:49:89:90:AF:E8:50:63:55:B6:F4:CB:31:27:5C
# Google's attestation revocation list; default is correct — do not override
# outside tests (a non-Google endpoint means revoked devices still pass).
# ANDROID_ATTESTATION_CRL_URL=https://android.googleapis.com/attestation/status
# CRL cache TTL in seconds (default 3600 = 1 hour, per the attestation spec)
# ANDROID_ATTESTATION_CRL_CACHE_TTL_SECS=3600
# Max age a cached CRL may reach while refreshes fail before it is refused
# (hard-mode 503). Default 3600 = 1 hour maximum staleness (spec SC-004).
# ANDROID_ATTESTATION_CRL_MAX_STALE_SECS=3600
# Play Integrity (self-managed response encryption keys; optional until the
# Play Console key exchange with the Android team lands — without them every
# play-integrity verdict fails, posture-gated by ENFORCE_AUTH).
# Verdict acceptance mode: strict (production) | relaxed_device (nightly/paseo)
# | relaxed_all (preview/debug)
# PLAY_INTEGRITY_MODE=strict
# AES-256 response decryption key, base64 (from the Play Console .enc bundle)
# PLAY_INTEGRITY_DECRYPTION_KEY=
# EC P-256 verification key, base64 DER SPKI (same bundle)
# PLAY_INTEGRITY_VERIFICATION_KEY=
# TEMPORARY fallback until the self-managed keys land: legacy GOOGLE_CREDENTIALS
# (base64-encoded service-account JSON) enables decoding via Google's
# decodeIntegrityToken API. Self-managed keys take precedence when set.
# Delete this var (and the fallback) after the key exchange.
# GOOGLE_CREDENTIALS=
# Apple DeviceCheck (iOS uniqueness at username claim; attestation plan
# Phase 4). Disabled by default; when enabled the three key vars are required
# (legacy names) and the .p8 key must parse at startup.
# DEVICE_CHECK_IOS_ENABLED=false
# APPLE_TEAM_ID=P2PX3JU8FT
# DEVICE_CHECK_KEY_ID=
# .p8 PEM contents; \n-escaped single-line values are accepted
# DEVICE_CHECK_PRIVATE_KEY=
# Default is Apple production; use https://api.development.devicecheck.apple.com/v1 for dev
# DEVICE_CHECK_URL=https://api.devicecheck.apple.com/v1
# Log level (default: info)
RUST_LOG=info

# --- identity-chain-writer ---

# Signer secret URI (default: //Alice for dev)
CHAIN_WRITER_SIGNER_SURI=//Alice

# Optional: proxy for the cold attester primary (empty = sign directly)
CHAIN_WRITER_PROXY_FOR=

# How long the registration-queue service's lease may be expired before the
# writer drains stranded QUEUED rows into the direct path (queue-down fallback).
QUEUE_FALLBACK_AFTER_SECS=60

# --- registration-queue ---
#
# Single-instance queue advancer (own lease; optional at runtime — when it is
# down, identity-api and the writer fall back to direct registration). Shares
# DATABASE_URL / PEOPLE_RPC_URL with the identity section above.

# Queue advancer iteration interval, seconds (the spec's "every N seconds";
# up to 4 promotions per iteration).
QUEUE_ADVANCE_INTERVAL_SECS=6

# Advancer lease TTL, seconds. Must exceed the interval; while unexpired the
# queue counts as alive for intake and the writer's fallback drain.
QUEUE_LEASE_TTL_SECS=30

# --- dim-tickets ---
#
# Game/personhood invitation-credential service (own Postgres). As with
# username-indexer, the generic keys (DATABASE_URL / PEOPLE_RPC_URL / BIND_ADDR)
# collide with the identity section above, so they are documented here but
# commented; set them per process (or via compose) when running the
# `dim-tickets-api` / `dim-tickets-writer` binaries directly.

# Postgres connection string for dim-tickets (its own DB)
# DATABASE_URL=postgres://dim_tickets:dim_tickets@localhost:5434/dim_tickets

# Compose-only dim-tickets Postgres settings. Use a URL-safe random password in
# deployments; the local defaults keep `docker compose up` zero-config.
DIM_TICKETS_POSTGRES_USER=dim_tickets
DIM_TICKETS_POSTGRES_PASSWORD=dim_tickets
DIM_TICKETS_POSTGRES_DB=dim_tickets
DIM_TICKETS_POSTGRES_PORT=5434

# People Chain RPC URL (required; local dev uses Paseo Next v2)
# PEOPLE_RPC_URL=wss://paseo-people-next-system-rpc.polkadot.io

# Listen address
# BIND_ADDR=0.0.0.0:8080

# Network literal stamped into rows and responses (required; westend2|paseo|polkadot)
PEOPLE_NETWORK=paseo

# Inviter SS58 address whose on-chain AvailableInvites funds tickets (required)
INVITER_ADDRESS=5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY

# Verify-only JWT key material (required; exactly one of these two):
# an inline JWKS document as served by identity-service at /.well-known/jwks.json…
# JWT_JWKS_JSON={"keys":[…]}
# …or a pinned 32-byte Ed25519 public key as hex. This dev default is the
# public key of the dev JWT_ED25519_SECRET above.
JWT_ED25519_PUBLIC_KEY=0x8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c

# Budget for the synchronous on-chain quota read on the create path, seconds (>=1)
QUOTA_TIMEOUT_SECS=15

# Per-subject rate limit on the authenticated routes: requests per window (>=1)
RATE_LIMIT=30

# Rate-limit window, seconds (>=1)
RATE_LIMIT_WINDOW_SECS=60

# --- dim-tickets-writer ---
#
# Single-instance chain writer (one inviter key = one nonce lane; never scale
# it). Shares DATABASE_URL / PEOPLE_RPC_URL / PEOPLE_NETWORK / INVITER_ADDRESS
# with dim-tickets-api above; needs the inviter secret and no JWT material.

# Inviter signing secret: SURI (//Alice, mnemonic, 0x+64-hex seed) or a raw
# 0x+128-hex 64-byte sr25519 secret (required)
INVITER_SIGNER_SURI=//Alice

# Optional: cold inviter primary (SS58). When set, batches are wrapped in
# Proxy.proxy(real = this account, force_proxy_type = Any) and the SURI signs
# as its proxy (empty = sign directly).
INVITER_PROXY_FOR=

# Writer tunables (defaults mirror the legacy daemon)
WRITER_POLL_SECS=6              # 1..=86400
WRITER_BATCH_SIZE=10            # 1..=1000
WRITER_MAX_RETRIES=5            # 1..=1000
WRITER_RETRY_BASE_MS=1000       # 1..=86400000
WRITER_RETRY_MAX_MS=60000       # base..=86400000
WRITER_RETRY_MAX_EXPONENT=10    # 1..=63
WRITER_FINALIZE_SECS=120        # 1..=86400; covers signing through header fetch
WRITER_LEASE_TTL_SECS=30        # 3..=86400

# --- username-indexer ---
#
# Independently deployable public search service with its own Postgres.
# The compose file sets each service's DATABASE_URL / PEOPLE_RPC_URL / BIND_ADDR
# / RUST_LOG per service, so the four keys below (which collide with the identity
# sections above) are documented but left commented to avoid clobbering a shared
# .env. Uncomment them only when running the `username-indexer` binary directly.

# Postgres connection string for the username-indexer projection (its own DB)
# DATABASE_URL=postgres://username_indexer:username_indexer@localhost:5433/username_indexer

# People Chain RPC URL (mirrors the identity default: Paseo Next v2)
# PEOPLE_RPC_URL=wss://paseo-people-next-system-rpc.polkadot.io

# Listen address
# BIND_ADDR=0.0.0.0:8080

# Finalized storage scan page size (1..=1000)
STORAGE_PAGE_SIZE=1000

# Finalized poll interval, seconds (1..=86400)
SYNC_INTERVAL_SECS=30

# Public search rate limit: requests per window per client IP (>=1). This is the
# outermost layer on the route and does no crypto, so an exhausted window cannot
# be used to force JWT verification or puzzle hashing.
SEARCH_RATE_LIMIT=60

# Public search rate-limit window, seconds (>=1)
SEARCH_RATE_LIMIT_WINDOW_SECS=60

# Proof-of-compute gate on public search. OFF by default: with it off there is no
# `POST /api/v1/poc/issue` route and search behaves exactly as before.
#
# When ON the gate is either-or — a valid identity-service JWT satisfies search
# just as a solved puzzle does, so the shipping mobile apps (which authenticate
# search) need no change and only anonymous callers must mine. Turning it on
# therefore requires verify-only JWT material (JWT_JWKS_JSON or
# JWT_ED25519_PUBLIC_KEY) or the process refuses to boot.
POC_ENABLED=false

# Input keying material for the puzzle HMAC (HKDF-SHA256, legacy-compatible
# derivation). REQUIRED when POC_ENABLED=true (min 32 chars of random material —
# HKDF adds no entropy and every puzzle publishes a message/HMAC pair, so a weak
# secret is recoverable offline); ignored otherwise.
# POC_HMAC_SECRET=

# Required leading zero bits in a solution (1..=32; legacy's default is 16).
POC_DIFFICULTY_BITS=16

# Puzzle validity, seconds (>=1)
POC_SESSION_TTL_SECS=60

# Extra tolerance for client/server clock skew, seconds
POC_CLOCK_SKEW_SECS=30

# Log level
# RUST_LOG=info

# --- invite-tickets ---
#
# Synchronous invitation-credential claim service (the route the shipping apps
# call) with its own Postgres. Shares PEOPLE_NETWORK / JWT_JWKS_JSON /
# JWT_ED25519_PUBLIC_KEY / RATE_LIMIT / RATE_LIMIT_WINDOW_SECS with the
# dim-tickets section above; colliding keys stay commented (compose sets the
# per-service values). Uncomment only when running a bin directly.

# Postgres connection string for the invite-tickets pool (its own DB)
# DATABASE_URL=postgres://invite_tickets:invite_tickets@localhost:5435/invite_tickets

# Listen address (api bin; the pool bin has no HTTP)
# BIND_ADDR=0.0.0.0:8080

# --- invite-tickets-pool ---
#
# Single-instance pool maintainer (one inviter = one nonce lane; never scale
# it). MUST NOT sign as the same account as dim-tickets-writer above — compose
# interpolates these INVITE_INVITER_* host vars into the container's
# INVITER_* env so the two services default to different dev accounts
# (//Bob here vs the writer's //Alice). See docs/deploy.md "Nonce lanes".

# Invite inviter: its on-chain AvailableInvites funds tickets; stamped into rows
INVITE_INVITER_ADDRESS=5FHneW46xGXgs5mUiveU4sbTyGBzmstUspZC92UhjJM694ty

# Invite inviter signing secret: same accepted formats as the writers above
INVITE_INVITER_SIGNER_SURI=//Bob

# Optional: cold invite-inviter primary (SS58) for Proxy.proxy signing
INVITE_INVITER_PROXY_FOR=

# Pool tunables (defaults mirror the legacy daemon)
POOL_DIMS=Game,ProofOfInk       # comma-separated subset of Game,ProofOfInk
POOL_TARGET_SIZE=10000          # 1..=10000000 available tickets per pool
POOL_BATCH_MAX=100              # 1..=1000; AIMD: grow by 1, halve on failure
POOL_INTERVAL_SECS=6            # 1..=86400
POOL_FINALIZE_SECS=60           # 1..=86400; covers submit through finalization

# --- turn-api ---
#
# Stateless TURN credential issuer (safe to scale). The secret + algorithm
# MUST match the TURN relay's coturn `--use-auth-secret` configuration, or
# minted credentials will not authenticate; rotate relay + issuer together.

# Base64-encoded HMAC secret shared with the TURN relay (required)
TURN_SECRET=<base64-secret>

# HMAC algorithm: SHA1 (coturn default) | SHA256 | SHA384 | SHA512
TURN_AUTH_ALGORITHM=SHA1

# Credential TTL in seconds (legacy TURN_TTL="30 minutes" → 1800)
TURN_TTL_SECS=1800

# TURN realm (configured on the relay; reserved here — validated, not on the wire)
TURN_REALM=example.org

# Comma-separated ICE server URLs echoed verbatim in every 201 body
ICE_SERVERS=stun:stun.example.com:3478,turn:turn.example.com:3478?transport=udp

# --- gateway (compose service; prod uses host Caddy with the same file) ---
#
# Route-by-route cutover: the deployed legacy backend origin for routes with
# no Rust owner yet (notify, poc, schemas, subscriptions, admin, debug).
# host:port or https://host — unset, those routes 404 via identity-api.
# LEGACY_BACKEND_ORIGIN=https://legacy.example.com

# --- notifications (notify-relay) ---
#
# Stateless, DB-free `/api/v1/notify` relay. It is verify-only: it validates
# identity-service's JWT with the public key below and never holds a signing key.
# BIND_ADDR / RUST_LOG collide with the sections above, so they are left commented
# to avoid clobbering a shared .env; uncomment when running notify-relay directly.

# identity-service's Ed25519 JWT PUBLIC key — 0x-prefixed 64-char hex.
# This is the public half of identity-service's JWT_ED25519_SECRET. For the dev
# secret above (seed 0x0101..01) the matching public key is:
JWT_ED25519_PUBLIC_KEY=0x8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c
# Alternatively, set JWT_JWKS_JSON to identity-service's /.well-known/jwks.json
# body — a non-empty value wins over JWT_ED25519_PUBLIC_KEY.
# JWT_JWKS_JSON=

# Listen address
# BIND_ADDR=0.0.0.0:8080

# Log level
# RUST_LOG=info

# Per-subject rate limit for POST /api/v1/notify: requests per window per
# authenticated JWT subject (accountId), keyed on subject+route, never raw IP.
NOTIFY_RATE_LIMIT=60

# Notify rate-limit window, seconds (>=1)
NOTIFY_RATE_LIMIT_WINDOW_SECS=60

# iOS APNs provider (optional; unset = unconfigured stub). Point APNS_KEY_FILE at
# your .p8 anywhere on the host; compose mounts it read-only (no key in the repo).
# It must be readable by the container user: chown 10001:10001 + chmod 0400.
# Running the binary directly? Use APNS_PRIVATE_KEY_FILE (path) or APNS_PRIVATE_KEY
# (inline PEM). Key id + team id + topic + environment are required with the key.
# APNS_KEY_FILE=/absolute/path/to/AuthKey_XXXX.p8
# APNS_KEY_ID=73L6WWUQ3F
# APNS_TEAM_ID=P2PX3JU8FT
# APNS_TOPIC=io.parity.brevity
# APNS_ENVIRONMENT=development   # or production (App Store / TestFlight)

# Android FCM provider (optional). When FCM_SERVICE_ACCOUNT_JSON is set the relay
# wires the real FCM provider for Android; when absent, Android pushes report
# provider failure (unconfigured stub). The value is the full Firebase
# service-account JSON (project_id + client_email + private_key). Keep secret.
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
